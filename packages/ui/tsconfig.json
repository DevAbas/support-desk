{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.tmp/ui.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "lib": ["ES2023", "DOM"],
    "jsx": "react-jsx",

    /* Bundler mode */
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": ["src"],
  "references": [
    {
      "path": "../shared"
    }
  ]
}
