{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.tmp/api.tsbuildinfo",
    "types": ["node"],
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "dist",

    /* tsx transpiles this the way a bundler would, extensionless imports and
       all, and the modules shared with the client are written that way. */
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": ["src"],
  "references": [
    {
      "path": "../../packages/shared"
    }
  ]
}
